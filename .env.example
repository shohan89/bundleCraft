# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Supabase). Used by Prisma.
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only).
DATABASE_URL=

# Connect to Postgres via the shared session-mode pooler (used for migrations).
DIRECT_URL=

# Shopify Partner app credentials (Partners dashboard > App > Client credentials).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public URL the Shopify app is served from (tunnel URL in development).
SHOPIFY_APP_URL=

# Public base URL of this Next.js app, exposed to the browser.
NEXT_PUBLIC_APP_URL=
