# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Supabase). Used by Prisma.
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only).
DATABASE_URL=

# Connect to Postgres via the shared session-mode pooler (used for migrations).
DIRECT_URL=

# Shopify Partner app credentials (Partners dashboard > App > Client credentials).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public URL the Shopify app is served from (tunnel URL in development).
SHOPIFY_APP_URL=

# Public base URL of this Next.js app, exposed to the browser.
NEXT_PUBLIC_APP_URL=

# Server-side secret used to derive session-signing and access-token
# encryption keys (see lib/auth/crypto.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this invalidates all existing sessions AND makes previously
# encrypted access tokens undecryptable — merchants would need to
# reinstall. Never reuse across environments.
SESSION_SECRET=
