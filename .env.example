# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Supabase). Used by Prisma.
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only).
DATABASE_URL=

# Connect to Postgres via the shared session-mode pooler (used for migrations).
DIRECT_URL=

# Shopify Partner app credentials (Partners dashboard > App > Client credentials).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public URL the Shopify app is served from (tunnel URL in development).
SHOPIFY_APP_URL=

# Public base URL of this Next.js app, exposed to the browser. Must be the same origin as
# SHOPIFY_APP_URL (npm run check:production enforces it). No application code reads it yet; it is
# part of the deployment contract so a future client-side use cannot ship with a wrong value.
NEXT_PUBLIC_APP_URL=

# Server-side secret used to derive session-signing and access-token
# encryption keys (see lib/auth/crypto.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this invalidates all existing sessions AND makes previously
# encrypted access tokens undecryptable — merchants would need to
# reinstall. Never reuse across environments.
SESSION_SECRET=

# Billing (ACTION-009). Charges are Shopify TEST charges (approval works, nothing is billed)
# unless this is exactly "true". Set it in production only.
SHOPIFY_BILLING_LIVE=

# ---------------------------------------------------------------------------
# Optional tuning (ACTION-016/017). Leave unset in production unless you know why.
# ---------------------------------------------------------------------------
# Rate limiting is ON unless this is exactly "off" (the test suite turns it off). Never "off" in production.
# RATE_LIMIT=
# Milliseconds the verified storefront shop is cached (default 30000) and the template catalog (default 60000).
# 0 disables a cache. Both are per server process.
# STOREFRONT_SHOP_CACHE_MS=
# TEMPLATE_CACHE_MS=
