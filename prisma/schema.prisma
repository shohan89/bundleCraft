// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Source of truth for these models: docs/04-DATABASE_DESIGN.md and
// tasks/phase-02-database/database-implementation.md. Field lists are kept
// literal to those docs — no speculative fields were added.

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  // ACTION-016: lets a query load its relations in ONE joined statement (relationLoadStrategy).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ShopPlan {
  free
  starter
  growth
  pro
}

enum ShopStatus {
  active
  inactive
}

enum BundleType {
  fixed
  quantity
  mix_match
}

enum DiscountType {
  percentage
  fixed_amount
}

enum BundleStatus {
  draft
  active
  inactive
}

enum TemplateCategory {
  fashion
  beauty
}

enum CustomizationLayout {
  card
  horizontal
  vertical
}

/// Storefront customization options (ACTION-015). Predefined values only; see lib/customization.
enum FontFamily {
  theme
  sans
  serif
  mono
}

enum TextSize {
  small
  medium
  large
}

enum CardRadius {
  none
  small
  medium
  large
}

enum CardShadow {
  none
  subtle
  strong
}

enum ButtonStyle {
  filled
  outline
}

enum ButtonSize {
  small
  medium
  large
}

enum SpacingDensity {
  compact
  comfortable
}

enum AnalyticsEventType {
  bundle_view
  bundle_add
  bundle_purchase
}

enum ProductStatus {
  active
  draft
  archived
  /// No longer exists in Shopify. The row is kept so bundles and analytics keep their references.
  deleted
}

enum CatalogSyncStatus {
  /// Never synced (or reset by a reinstall).
  pending
  syncing
  /// A run stopped at its time budget with pages left; the next run resumes at the cursor.
  partial
  synced
  failed
}

enum WebhookEventStatus {
  /// Claimed by a delivery that is running (or crashed mid-run; reclaimed after a timeout).
  processing
  processed
  /// The handler threw; the next Shopify retry may reclaim it.
  failed
}

enum SubscriptionStatus {
  active
  cancelled
  /// ACTION-009: created at Shopify, waiting for the merchant to approve.
  pending
  /// ACTION-009: no longer in force (Shopify expired or froze it, or an unapproved request lapsed).
  expired
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Application users. Not documented as tenant-scoped or linked to Shop by
/// any field in docs/04-DATABASE_DESIGN.md or tasks/phase-02 — implemented
/// as a standalone table per the literal field list.
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// A Shopify merchant / tenant. All merchant-owned data (bundles, analytics,
/// subscription) is isolated by shopId.
model Shop {
  id                   String            @id @default(uuid()) @db.Uuid
  shopDomain           String            @unique @map("shop_domain")
  accessToken          String            @map("access_token")
  email                String
  plan                 ShopPlan          @default(free)
  status               ShopStatus        @default(active)
  /// Last (re)install time. A webhook triggered before this belongs to an earlier install.
  installedAt          DateTime          @default(now()) @map("installed_at")
  /// Set by the app/uninstalled webhook and never cleared: sessions issued at or before
  /// this moment stay invalid even after a reinstall makes the shop active again.
  uninstalledAt        DateTime?         @map("uninstalled_at")
  /// Product catalog sync state (ACTION-012). Shopify is the source of truth; see services/products.
  catalogSyncStatus    CatalogSyncStatus @default(pending) @map("catalog_sync_status")
  catalogSyncCursor    String?           @map("catalog_sync_cursor")
  catalogSyncStartedAt DateTime?         @map("catalog_sync_started_at")
  /// When the last COMPLETE sync finished.
  catalogSyncedAt      DateTime?         @map("catalog_synced_at")
  /// A short error code from the last failed run, never a message.
  catalogSyncError     String?           @map("catalog_sync_error")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  bundles         Bundle[]
  analyticsEvents AnalyticsEvent[]
  subscriptions   Subscription[]
  webhookEvents   WebhookEvent[]
  products        Product[]
  productVariants ProductVariant[]

  @@index([shopDomain])
  @@map("shops")
}

/// A merchant-created product bundle.
model Bundle {
  id                String       @id @default(uuid()) @db.Uuid
  shopId            String       @map("shop_id") @db.Uuid
  title             String
  description       String?
  bundleType        BundleType   @map("bundle_type")
  discountType      DiscountType @map("discount_type")
  discountValue     Decimal      @map("discount_value") @db.Decimal(10, 2)
  status            BundleStatus @default(draft)
  /// Units the customer must buy/select. Required for quantity and
  /// mix_match bundles ("Choose any 3"), unused (null) for fixed bundles.
  /// Enforced in lib/bundles/rules.ts, not at the DB level.
  requiredQuantity  Int?         @map("required_quantity")
  /// Optional: the template this bundle was started from (wizard step 1).
  templateId        String?      @map("template_id") @db.Uuid
  /// Global id (gid://shopify/DiscountAutomaticNode/...) of the app-owned
  /// automatic discount that applies this bundle's price at checkout
  /// (ACTION-007). Set on first publish and reused afterwards so syncing is
  /// idempotent; the unique index also stops two bundles sharing a discount.
  shopifyDiscountId String?      @unique @map("shopify_discount_id")
  /// When the Shopify discount was last successfully synced from this row.
  discountSyncedAt  DateTime?    @map("discount_synced_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  template        Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  bundleProducts  BundleProduct[]
  customization   Customization?
  analyticsEvents AnalyticsEvent[]

  @@index([shopId])
  @@index([status])
  @@index([templateId])
  @@map("bundles")
}

/// Links a Bundle to the Shopify products/variants that make it up.
model BundleProduct {
  id               String   @id @default(uuid()) @db.Uuid
  bundleId         String   @map("bundle_id") @db.Uuid
  shopifyProductId String   @map("shopify_product_id")
  shopifyVariantId String   @map("shopify_variant_id")
  quantity         Int      @default(1)
  position         Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")

  bundle Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([bundleId])
  @@map("bundle_products")
}

/// Predefined bundle templates shared across all shops (not tenant-scoped).
///
/// A template is a starting blueprint, never a bundle: a bundle only keeps a reference
/// (template_id) and copies the defaults it was started with (ACTION-014).
model Template {
  id                String           @id @default(uuid()) @db.Uuid
  /// Stable identity of a catalog template (e.g. "complete-look"); what the seed upserts on.
  slug              String           @unique
  name              String
  category          TemplateCategory
  /// Validated by lib/templates/config.ts before it is ever used or sent to a browser.
  configurationJson Json             @map("configuration_json")
  /// Inactive templates stay stored (bundles keep their reference) but are not offered.
  isActive          Boolean          @default(true) @map("is_active")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  bundles Bundle[]

  @@unique([name, category])
  @@map("templates")
}

/// Storefront widget appearance settings for a single Bundle.
model Customization {
  id              String              @id @default(uuid()) @db.Uuid
  bundleId        String              @unique @map("bundle_id") @db.Uuid
  primaryColor    String              @map("primary_color")
  buttonColor     String              @map("button_color")
  backgroundColor String              @map("background_color")
  layout          CustomizationLayout @default(card)
  fontSize        Int                 @map("font_size")
  /// ACTION-015. Existing rows were backfilled to look exactly as before.
  accentColor     String              @default("#111827") @map("accent_color")
  textColor       String              @default("#111827") @map("text_color")
  fontFamily      FontFamily          @default(theme) @map("font_family")
  titleSize       TextSize            @default(medium) @map("title_size")
  descriptionSize TextSize            @default(medium) @map("description_size")
  cardRadius      CardRadius          @default(medium) @map("card_radius")
  cardShadow      CardShadow          @default(none) @map("card_shadow")
  buttonStyle     ButtonStyle         @default(filled) @map("button_style")
  buttonSize      ButtonSize          @default(medium) @map("button_size")
  spacingDensity  SpacingDensity      @default(comfortable) @map("spacing_density")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  bundle Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@map("customizations")
}

/// Bundle performance tracking events (views, adds, purchases).
model AnalyticsEvent {
  id           String             @id @default(uuid()) @db.Uuid
  shopId       String             @map("shop_id") @db.Uuid
  bundleId     String             @map("bundle_id") @db.Uuid
  eventType    AnalyticsEventType @map("event_type")
  revenue      Decimal?           @db.Decimal(10, 2)
  /// ISO 4217 code of `revenue` (the shop currency of the order). Purchase events only.
  currency     String?            @db.VarChar(3)
  /// Shopify order reference (gid://shopify/Order/...). Purchase events only.
  orderId      String?            @map("order_id")
  /// Idempotency key, unique per shop: retries, double-clicks and webhook
  /// redeliveries carry the same key, so they insert one row (ACTION-008).
  eventKey     String?            @map("event_key")
  metadataJson Json?              @map("metadata_json")
  createdAt    DateTime           @default(now()) @map("created_at")

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bundle Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([shopId, eventKey])
  // (shop_id) and (bundle_id) alone were removed in ACTION-016: each is the leading column of a
  // composite below (or of the unique key), so they only added write cost and disk.
  @@index([createdAt])
  @@index([shopId, eventType, createdAt])
  @@index([bundleId, eventType, createdAt])
  @@map("analytics_events")
}

/// Shopify billing / subscription history for a Shop (ACTION-009). One Shop has
/// many rows over time and at most one `active`.
model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  /// One shop has many rows over time (history is kept, never deleted); at most one is `active`
  /// (enforced in services/billing/subscriptions.ts under a per-shop advisory lock).
  shopId           String             @map("shop_id") @db.Uuid
  /// Global id of the Shopify AppSubscription (gid://shopify/AppSubscription/...). Unique so a
  /// Shopify subscription can never be recorded twice.
  shopifyChargeId  String             @unique @map("shopify_charge_id")
  plan             ShopPlan
  status           SubscriptionStatus @default(active)
  startedAt        DateTime           @default(now()) @map("started_at")
  cancelledAt      DateTime?          @map("cancelled_at")
  /// End of the current Shopify billing period, as last reported by Shopify.
  currentPeriodEnd DateTime?          @map("current_period_end")
  /// Shopify approval URL while `pending`; lets a repeated request resume instead of creating a second charge.
  confirmationUrl  String?            @map("confirmation_url")
  /// True for Shopify test charges (no money moves).
  isTest           Boolean            @default(false) @map("is_test")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
  @@map("subscriptions")
}

/// One row per Shopify webhook event we accepted (ACTION-011): the durable idempotency record.
/// Holds no payload, only identifiers and outcome, so no customer data is retained.
model WebhookEvent {
  id          String             @id @default(uuid()) @db.Uuid
  shopId      String             @map("shop_id") @db.Uuid
  /// Shopify topic, e.g. "orders/paid".
  topic       String
  /// X-Shopify-Event-Id (or a body hash when Shopify sends none): identical on every redelivery.
  eventId     String             @map("event_id")
  /// The Shopify resource the event is about (e.g. a product gid), for hand-off to later work.
  resourceId  String?            @map("resource_id")
  status      WebhookEventStatus @default(processing)
  attempts    Int                @default(1)
  /// A short error code, never a payload or a raw error message.
  lastError   String?            @map("last_error")
  processedAt DateTime?          @map("processed_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, topic, eventId])
  @@index([status, updatedAt])
  @@index([shopId, createdAt])
  @@map("webhook_events")
}

/// A Shopify product as last synced (ACTION-012). Shopify is authoritative: nothing here is
/// edited from the dashboard. Only fields the bundle builder and storefront use are kept.
model Product {
  id               String        @id @default(uuid()) @db.Uuid
  shopId           String        @map("shop_id") @db.Uuid
  /// Numeric Shopify product id (no gid prefix).
  shopifyProductId String        @map("shopify_product_id")
  title            String
  handle           String
  status           ProductStatus
  vendor           String?
  productType      String?       @map("product_type")
  imageUrl         String?       @map("image_url")
  /// Shopify updatedAt for the data held: an older delivery never overwrites newer data.
  shopifyUpdatedAt DateTime?     @map("shopify_updated_at")
  deletedAt        DateTime?     @map("deleted_at")
  syncedAt         DateTime      @default(now()) @map("synced_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")

  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([shopId, shopifyProductId])
  @@index([shopId, status])
  @@index([shopId, title])
  @@map("products")
}

/// A Shopify variant as last synced. Identity is (shop, Shopify variant id), never title, SKU or price.
model ProductVariant {
  id               String    @id @default(uuid()) @db.Uuid
  /// Denormalised from the product so uniqueness and every lookup is tenant-scoped in one index.
  shopId           String    @map("shop_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  /// Numeric Shopify variant id (no gid prefix).
  shopifyVariantId String    @map("shopify_variant_id")
  title            String
  sku              String?
  /// Shop-currency price. Currency conversion and Markets pricing are out of scope.
  price            Decimal?  @db.Decimal(12, 2)
  compareAtPrice   Decimal?  @map("compare_at_price") @db.Decimal(12, 2)
  availableForSale Boolean   @map("available_for_sale")
  imageUrl         String?   @map("image_url")
  position         Int       @default(0)
  /// Set when Shopify no longer lists the variant; the row stays so references remain readable.
  removedAt        DateTime? @map("removed_at")
  syncedAt         DateTime  @default(now()) @map("synced_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([shopId, shopifyVariantId])
  @@index([productId])
  @@map("product_variants")
}
